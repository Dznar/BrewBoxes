{
  "identifier": "default",
  "description": "Default capabilities for the app",
  "local": true,
  "windows": ["*"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "typst",
          "cmd": "typst",
          "args": ["compile", { "validator": ".*" }, { "validator": ".*" }, { "validator": ".*" }, { "validator": ".*" }, { "validator": ".*" }]
        },
        {
            "name": "typst",
            "cmd": "typst",
            "args": ["fonts"]
        },
        {
            "name": "typst",
            "cmd": "typst",
            "args": ["fonts", "--font-path", { "validator": ".*" }, "--ignore-system-fonts"]
        }
      ]
    },
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-copy-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-exists",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
